---
// The NAP (name / address / phone) card on each location page.
// All values come from src/data/locations.ts — never hardcode NAP here.
//
// Rows OMIT THEMSELVES when their data is missing rather than rendering a
// bracket placeholder (changed 2026-07-28). Two reasons: the placeholders were
// publicly visible on the live site, and a pre-opening campus with no phone or
// no confirmed date is normal — an absent row reads as "not announced yet",
// while "[PHONE TBD]" reads as an unfinished website.
import type { Location } from "../data/locations";

interface Props {
  loc: Location;
}
const { loc } = Astro.props;
---

<aside class="location-nap-card" id="nap" aria-labelledby="nap-heading">
  <h2 id="nap-heading" class="nap-heading">{loc.napHeading}</h2>

  <dl class="nap-list">
    <div>
      <dt>Address</dt>
      <dd>
        <address>
          {loc.streetAddress && <Fragment><span>{loc.streetAddress}</span><br /></Fragment>}
          {loc.cityState}{loc.postalCode ? ` ${loc.postalCode}` : ""}
        </address>
      </dd>
    </div>
    {loc.telephone && (
      <div>
        <dt>Phone</dt>
        <dd>
          <a href={`tel:${loc.telephone.replace(/[^+\d]/g, "")}`}>{loc.telephone}</a>
        </dd>
      </div>
    )}
    <div>
      <dt>Email</dt>
      <dd><a href={`mailto:${loc.email}`}>{loc.email}</a></dd>
    </div>
    <div>
      <dt>Hours</dt>
      <dd>Monday–Friday<br />6:30 AM – 6:00 PM</dd>
    </div>
    <div>
      <dt>Opening</dt>
      <dd>{loc.openingLabel ?? "Date to be announced"}</dd>
    </div>
  </dl>
</aside>
